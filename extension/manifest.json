{
  "manifest_version": 3,
  "name": "JKT48 Radar Bridge - 4 Events",
  "version": "1.2.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://jkt48.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://jkt48.com/purchase/exclusive*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://jkt48.com/purchase/exclusive*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
